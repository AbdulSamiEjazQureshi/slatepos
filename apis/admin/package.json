{
  "name": "@roms/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.16",
    "@elysia/static": "^1.4.11",
    "@roms/config": "workspace:*",
    "@roms/contracts": "workspace:*",
    "@roms/database": "workspace:*",
    "@roms/utils": "workspace:*",
    "elysia": "^1.4.30",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3"
  }
}
