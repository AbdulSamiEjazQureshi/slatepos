{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "vite/client"],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"src/**/*.js",
		"src/app.d.ts",
		"vite.config.ts",
		"vitest.config.ts"
	]
}
