# ---------------------------------------------------------------------------
# ROMS environment configuration
# Copy to `.env` (git-ignored) and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- API -----------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- Authentication ------------------------------------------------------
# Use 32+ byte random strings in real deployments.
JWT_SECRET=dev-only-change-me-jwt-secret-0123456789
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# --- Database ------------------------------------------------------------
# Driver: `pglite` (embedded Postgres, zero-setup, dev/test) or `postgres` (real server).
DATABASE_DRIVER=pglite
# PGlite data directory (used when DATABASE_DRIVER=pglite)
PGLITE_DIR=.data/pglite
# Postgres connection string (used when DATABASE_DRIVER=postgres)
DATABASE_URL=postgres://roms:roms@localhost:5432/roms

# --- Cache / queues ------------------------------------------------------
# Leave empty to use the in-process adapter.
REDIS_URL=

# --- Email ---------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_PROVIDER_KEY=
EMAIL_FROM=no-reply@roms.local

# --- Storage -------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/storage
STORAGE_BUCKET=
STORAGE_REGION=

# --- Public / frontend ---------------------------------------------------
VITE_API_URL=http://localhost:3000
